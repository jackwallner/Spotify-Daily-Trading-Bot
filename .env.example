# Kalshi API Credentials
# Get these from: https://trading.kalshi.com/trade-api/
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
your_private_key_content_here
-----END PRIVATE KEY-----

# Note: No Spotify API credentials needed - bot now uses Kworb for chart data
# Kworb provides real-time Spotify chart data without requiring API access

# Optional: Gemini decision layer
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: force the market date suffix (YYmonDD), e.g. 26jan02
# SPOTIFY_MARKET_DATE=26jan02

# Optional: stream delta threshold percentage for volatility logging
# KWORB_STREAM_DELTA_THRESHOLD_PCT=5.0

# Optional: Gemini decision layer
# GEMINI_API_KEY=your_gemini_api_key_here

# Spotify daily market targeting (optional overrides)
# SPOTIFY_MARKET_REQUIRED_KEYWORDS=spotify
# SPOTIFY_MARKET_DAILY_KEYWORDS=daily
# SPOTIFY_MARKET_EXCLUDE_KEYWORDS=
#
# If you know the exact Kalshi tickers, set these to avoid broad scanning:
# SPOTIFY_SERIES_TICKERS=
# SPOTIFY_EVENT_TICKERS=
#
# Discovery + execution tuning
# SPOTIFY_DAILY_MAX_MARKETS_PER_RUN=3
# SPOTIFY_DAILY_CLOSE_WINDOW_HOURS=36
# LIMIT_PRICE_BUFFER_CENTS=2
# KALSHI_MARKETS_LIMIT=200
# KALSHI_MARKETS_MAX_PAGES=10

